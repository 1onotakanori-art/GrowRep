rules_version = '2';

// =====================================================================
// ⚠️ このファイルは GitHub Actions では配信されない
//
// GitHub Actions（.github/workflows/deploy.yml）が配信するのは
// GitHub Pages のフロントエンドだけ。Firestore のルールは別物なので、
// このファイルを変更したら必ず本番へデプロイすること:
//
//     ./scripts/deploy-firestore-rules.sh
//     （中身は firebase deploy --only firestore:rules --project prod）
//
// デプロイし忘れると、新しく足したコレクション（special_event_proposals
// など）は「ルール未定義＝すべて拒否」になり、アプリ側には
// "Missing or insufficient permissions." としか出ないので気づきにくい。
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    
    // users コレクション
    match /users/{userId} {
      // 認証済みユーザーのみ読み取り可能
      allow read: if request.auth != null;
      
      // 本人のみ作成・更新可能
      allow create, update: if request.auth != null 
                            && request.auth.uid == userId;
      
      // 削除は禁止
      allow delete: if false;
    }
    
    // posts コレクション
    match /posts/{postId} {
      // 認証済みユーザーのみ読み取り可能
      allow read: if request.auth != null;
      
      // 認証済みユーザーは投稿作成可能
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      
      // 誰でも更新可能（いいね・コメント追加）
      // ただし認証済みユーザーのみ
      allow update: if request.auth != null;
                    
      // 投稿者本人のみ削除可能
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }
    
    // posts_interval コレクション（インターバルモード用）
    match /posts_interval/{postId} {
      // 認証済みユーザーのみ読み取り可能
      allow read: if request.auth != null;
      
      // 認証済みユーザーは投稿作成可能
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      
      // 誰でも更新可能（いいね・コメント追加）
      // ただし認証済みユーザーのみ
      allow update: if request.auth != null;
                    
      // 投稿者本人のみ削除可能
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }
    
    // settings コレクション
    match /settings/{docId} {
      // 認証済みユーザーのみ読み取り可能
      allow read: if request.auth != null;
      
      // 認証済みユーザーのみ更新可能（6人グループなので全員が管理者）
      allow create, update: if request.auth != null;
      
      // 削除は禁止
      allow delete: if false;
    }
    
    // settings_interval コレクション（インターバルモード用）
    match /settings_interval/{docId} {
      // 認証済みユーザーのみ読み取り可能
      allow read: if request.auth != null;

      // 認証済みユーザーのみ更新可能（6人グループなので全員が管理者）
      allow create, update: if request.auth != null;

      // 削除は禁止
      allow delete: if false;
    }

    // posts_free コレクション（フリーモード用）
    match /posts_free/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // settings_free コレクション（フリーモード用）
    // 週間チャレンジの上書き設定は対象週ごとに1ドキュメント
    // （weekly_override_<月曜キー>, 例 weekly_override_2026-09-07）。
    // 承認された特別イベントも管理画面の手動設定もここに書き込む。
    match /settings_free/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      // 週間チャレンジの override 無効化等、管理操作で削除が必要なため認証済みユーザーに許可
      allow delete: if request.auth != null;
    }

    // weekly_reports コレクション（週次ウィークリー: Cowork週報 + 分析ダッシュボード）
    // ローカルPCのサービスアカウント（admin SDK）からのみ publish される「公式発表」。
    // admin SDK はルールを無視して書き込めるため、クライアントは読み取り専用にして改ざんを防ぐ。
    match /weekly_reports/{weekId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // weekly_champions コレクション（歴代チャンプ記録）
    match /weekly_champions/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // weekly_challenge_history コレクション（週間チャレンジ履歴）
    match /weekly_challenge_history/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // special_event_proposals コレクション（特別イベントウィークの提案・承認）
    // 提案は本人だけが作成でき、承認者に選ばれた人だけが回答（responses/status）
    // を書き換えられる。3人の回答が揃い、全員承認なら
    // settings_free/weekly_override_<対象週の月曜キー> が更新される。
    // 提案者は自分の提案の取り下げ（status: withdrawn）と、
    // 結果ポップアップの既読（resultSeenAt）だけを書き込める。
    match /special_event_proposals/{proposalId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.proposerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.get('responses', {}).size() == 0;

      // 承認者: 承認/否認の回答（否認理由コメントを含む）
      // 回答できるのは pending の間だけ。取り下げ済み・確定済みの提案を
      // あとから書き換えて生き返らせることはできない。
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.approverIds
                    && resource.data.get('status', 'pending') == 'pending'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['responses', 'status', 'updatedAt']);

      // 提案者: 回答が揃う前なら自分の提案を取り下げられる。
      // 取り下げは pending → withdrawn の一方通行で、他のフィールドは触れない。
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.proposerId
                    && resource.data.get('status', 'pending') == 'pending'
                    && request.resource.data.status == 'withdrawn'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'withdrawnAt', 'updatedAt']);

      // 提案者: 結果ポップアップを確認したことの記録だけ
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.proposerId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['resultSeenAt']);

      allow delete: if false;
    }

    // exercise_ratings コレクション（種目評価）
    // 親ドキュメント: 集計データ（avgRating, ratingCount, ratingSum）
    // サブコレクション user_ratings: 個人の評価（本人のみ書き込み可）
    match /exercise_ratings/{exerciseKey} {
      allow read: if request.auth != null;
      // 集計ドキュメントは認証済みユーザーが書き込み可（クライアント側でバッチ更新）
      allow create, update: if request.auth != null;
      allow delete: if false;

      match /user_ratings/{userId} {
        allow read: if request.auth != null;
        // 本人のみ作成・更新可能
        allow create, update: if request.auth != null
                              && request.auth.uid == userId;
        allow delete: if false;
      }
    }
  }
}
