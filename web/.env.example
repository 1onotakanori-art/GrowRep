# Firebase 設定（Firebase Console → プロジェクト設定 → マイアプリ から取得）
# ローカルでは web/.env にコピーして値を埋める。Vercel では環境変数として登録する。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=growrep-65c18.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=growrep-65c18
VITE_FIREBASE_STORAGE_BUCKET=growrep-65c18.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=140764534093
VITE_FIREBASE_APP_ID=1:140764534093:web:30f7500100b9d03de59304

# ゲストログイン用の共有アカウント資格情報（既存アプリと同一のもの）
